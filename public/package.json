{
  "name": "kryptik-passcode",
  "private": true,
  "version": "1.1.0",
  "description": "Kryptik Passcodes — a zero-knowledge password toolkit: live strength checker, CSPRNG password generator, and an encrypted personal vault. The server never sees your master password.",
  "main": "server/server.js",
  "scripts": {
    "start": "npm run dev",
    "dev": "nodemon server/server.js",
    "test": "node --test",
    "check:syntax": "find server public/assets/logic -type f -name '*.js' -print0 | xargs -0 -n1 node --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gonzobonzogit/Kryptik.git"
  },
  "keywords": [
    "password-manager",
    "zero-knowledge",
    "encryption",
    "aes-gcm",
    "security",
    "express",
    "postgresql"
  ],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Gonzobonzogit/Kryptik/issues"
  },
  "homepage": "https://github.com/Gonzobonzogit/Kryptik",
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "nodemon": "^3.1.14",
    "pg": "^8.23.1"
  }
}
